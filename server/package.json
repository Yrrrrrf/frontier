{
  "name": "frontier-agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate": "npm run check && npm test",
    "validate:desktop": "tsx src/validate-desktop.ts",
    "validate:vision": "tsx src/validate-vision.ts"
  },
  "dependencies": {
    "arktype": "2.2.9",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
